#include <bits/stdc++.h>
using namespace std;
// 1101110
// int countZero=0;1111
int main()
{
    string inputString="11011101111";
    // optimized accroach sliding window
    int size=inputString.size();
    int count=0;
    int i=-1;
    int j=0;
    int countZero=0;
    int storePrevZeroIndex=-1;
    while(j<size)
    {
        if(inputString[j]=='0' && countZero==0)
        {
            countZero++;
            storePrevZeroIndex=j;
        }
        // case for second zero
        else if(inputString[j]=='0' && countZero==1)
        {
            // 1101110
            count=max(count,j-i);
            i=storePrevZeroIndex+1;
            countZero=1;
            storePrevZeroIndex=j;
        }
        j++;
    }
    count=max(count,j-i);
    cout<<count;
    return 0;
}


